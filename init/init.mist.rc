# SPDX-License-Identifier: Apache-2.0
# Mist firmware mount aliases and hardware service data directories.
on early-init
    setprop vendor.mist.dsp_requested 0
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    exec_start gki.modprobe
    start vendor.modprobe

    symlink /vendor/firmware_mnt /firmware
    symlink /vendor/bt_firmware /bt_firmware
    symlink /vendor/dsp /dsp

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom --early

    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs-data
    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system
    mkdir /data/vendor/qtee 0770 system system
    mkdir /data/vendor/ssrdump 0770 root system
    write /sys/kernel/cnss/fs_ready 1
    mkdir /data/vendor/audio 0770 audio audio
    mkdir /data/vendor/audio/acdbdata 0770 media audio
    mkdir /data/vendor/audio/acdbdata/delta 0770 media audio
    mkdir /data/vendor/camera 0770 camera camera
    mkdir /data/vendor/display 0770 system graphics
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/radio 0770 system radio
    mkdir /data/vendor/time 0700 system system
    mkdir /data/vendor/connectivity 0771 radio radio
    mkdir /data/vendor/media 0770 mediacodec media
    mkdir /data/vendor/tzstorage 0770 system system

# Normal Android module loading; keep recovery init independent.
service gki.modprobe /vendor/bin/system_dlkm_modprobe.sh
    class main
    user root
    group root system
    disabled
    stdio_to_kmsg
    seclabel u:r:vendor_modprobe:s0
    oneshot

service vendor.modprobe /vendor/bin/vendor_modprobe.sh
    class main
    user root
    group root system
    disabled
    stdio_to_kmsg
    seclabel u:r:vendor_modprobe:s0
    oneshot

# Firmware partitions are mounted during fs. Start DSPs after the module
# loader exits, rather than blocking init indefinitely on a failed loader.
# Event path handles readiness before boot; property path handles late readiness.
on early-boot
    setprop vendor.mist.normal_boot_ready 1

on early-boot && property:vendor.all.modules.ready=1 && property:vendor.mist.dsp_requested=0
    trigger mist-start-dsp

on property:vendor.mist.normal_boot_ready=1 && property:vendor.all.modules.ready=1 && property:vendor.mist.dsp_requested=0
    trigger mist-start-dsp

on mist-start-dsp && property:vendor.mist.dsp_requested=0
    setprop vendor.mist.dsp_requested 1
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/init.qti.write.sh /sys/kernel/boot_adsp/boot 1
    exec_background u:r:vendor_qti_init_shell_bg:s0 -- /vendor/bin/init.qti.write.sh /sys/kernel/boot_cdsp/boot 1

service vendor.pd_mapper /vendor/bin/pd-mapper
    class core
    user system
    group system

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    write /sys/kernel/qcom_rproc/shutdown_in_progress 1
    stop vendor.per_proxy

# Match stock boot service coordination and donor hardware access.
on boot
    chown system system /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/panel0-backlight/max_brightness
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio
    mkdir /mnt/vendor/persist/sensors 0770 system system
    mkdir /mnt/vendor/persist/display 0770 system graphics

on property:sys.boot_completed=1
    chown system system /sys/class/qcom-battery/input_suspend
    chmod 0660 /sys/class/qcom-battery/input_suspend
